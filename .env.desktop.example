# Desktop (offline) build settings. Copy to .env.desktop and run scripts/desktop/build.ps1
# This file becomes the .env inside the installed app on every PC.

APP_NAME="Continental Wholesale"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1
APP_TIMEZONE=America/New_York

# bundled MySQL (extras/mysql), started by the app on this port
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=poscontinental
DB_USERNAME=root
DB_PASSWORD=change-me-to-a-long-random-password

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=daily
FILESYSTEM_DISK=local

# offline sync: this install is a desktop PC
SYNC_MODE=client
SYNC_ID_STEP=100
SYNC_INTERVAL=60

NATIVEPHP_APP_ID=com.continentalwholesale.desktop
NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_AUTHOR="Continental Wholesale"
NATIVEPHP_APP_DESCRIPTION="Continental Wholesale desktop — works offline, syncs with the online POS"
NATIVEPHP_UPDATER_ENABLED=false
