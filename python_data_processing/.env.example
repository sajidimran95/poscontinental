# Copy to .env and edit

# --- Target POS MySQL (Laragon) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=poscontinentalwholesale
MYSQL_USER=root
MYSQL_PASSWORD=
COMPANY_ID=1

# --- Source Chief / MS SQL (after restoring production sql/Chieve.bak) ---
# Example LocalDB: DRIVER={ODBC Driver 18 for SQL Server};SERVER=(localdb)\MSSQLLocalDB;DATABASE=Chieve;Trusted_Connection=yes;TrustServerCertificate=yes
# Example Express: DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=Chieve;UID=sa;PWD=YourPassword;TrustServerCertificate=yes
MSSQL_CONN=

# When MSSQL is not available, set CSV_DIR after exporting tables with export_mssql.py or SSMS
CSV_DIR=staging/csv
